# ---- Database (local Postgres or Neon) ----
DATABASE_URL="postgresql://campusops:campusops@localhost:5432/campusops?schema=public"
# Neon: use the "pooled" URL for DATABASE_URL and the direct URL for DIRECT_URL
DIRECT_URL="postgresql://campusops:campusops@localhost:5432/campusops?schema=public"

# ---- Server ----
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"

# ---- Auth ----
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ---- File storage: "local" (disk, dev only) or "vercel-blob" (production) ----
STORAGE_DRIVER="local"
# Required only when STORAGE_DRIVER=vercel-blob
BLOB_READ_WRITE_TOKEN=""
# Public base URL of this API (used to build links to locally stored files)
PUBLIC_API_URL="http://localhost:4000"

# ---- Scheduled jobs (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>") ----
CRON_SECRET="change-me"

# ---- Login protection: max attempts per e-mail + IP address within the window ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
